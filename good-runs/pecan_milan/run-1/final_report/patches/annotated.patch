+# PECAN_PREFETCH_FACTOR: calibrated DataLoader prefetch depth (default 2 = torch default,
+# no-op unless overridden). Measured 2026-07-22 (baseline5): per-rank compute ~0.148s/batch
+# vs data-load ~0.134s/batch (comparable magnitude) yet exact sweep-line overlap analysis
+# showed 0% temporal overlap between compute and communication-io spans across all 48 ranks
+# -- classic Mohan et al. VLDB2021 "data stall" pattern. Raising prefetch_factor gives the
+# background DataLoader workers more queue depth to stay ahead of compute.
+PECAN_PREFETCH_FACTOR = int(os.environ.get("PECAN_PREFETCH_FACTOR", "2"))
+
+# PECAN_NUM_WORKERS: override for config["train"/"test"]["num_workers"] (default "0" = no
+# override, use the config value unchanged). Paired with the multiprocessing_context="spawn"
+# fix below on DataListLoader (nn_type==3/EGNN path): raising num_workers 2->6 under the
+# DEFAULT fork() context deadlocked hard (>300s, zero progress) because HIP/ROCm's device
+# context is already initialized (ModelTrainer.__init__ builds+places the model on-device
+# BEFORE PecanTrainer.train() ever constructs a DataLoader) -- forking a process with an
+# active HIP context is unsafe. spawn re-imports cleanly in the child instead of forking the
+# parent's (HIP-initialized) address space. Confirmed 2026-07-22 (session pecan_milan).
+PECAN_NUM_WORKERS = int(os.environ.get("PECAN_NUM_WORKERS", "0"))
+
+
+def _resolve_num_workers(cfg_value):
+    """Apply the PECAN_NUM_WORKERS env override on top of the yaml config value."""
+    return PECAN_NUM_WORKERS if PECAN_NUM_WORKERS > 0 else cfg_value
+
+
+# DataLoader workers (multiprocessing_context="spawn") never call dftracer's
+# finalize() -- only main_app.py's main process does, once, at the very end.
+# Each spawned worker gets its own dftracer C-core state (lazily initialized
+# on first dft_event_logging(...) call inside Dataset_PDB.__getitem__), but
+# persistent_workers=True keeps the process alive until interpreter exit, at
+# which point Python multiprocessing tears it down without running any
+# app-level cleanup. Result: the worker's dftracer log is a gzip stream that
+# was opened but never explicitly flushed/closed -- for a worker that
+# accumulates few events before an internal buffer-size auto-flush would
+# trigger (e.g. a val DataLoader worker with a small split), this produces a
+# literal 0-byte .pfw.gz file; for a busier worker (e.g. train) enough
+# periodic auto-flushes may happen by chance to leave partial-but-nonzero
+# data, which is *also* suspect (possibly missing its tail events). Fix:
+# every DataLoader worker registers its own atexit finalize via
+# worker_init_fn. MUST be a plain top-level function (not a closure/nested
+# function) -- multiprocessing_context="spawn" pickles worker_init_fn to
+# hand it to the child process, and a closure returned by a factory function
+# is not picklable (AttributeError: Can't pickle local object
+# '<factory>.<locals>.<inner>' -- hit and fixed 2026-07-22, session
+# pecan_milan). Any existing (e.g. dyad) per-worker init is looked up
+# dynamically via get_worker_info().dataset instead of being closed over.
+def _dftracer_worker_init(worker_id):
+    info = torch.utils.data.get_worker_info()
+    inner = getattr(info.dataset, "worker_init", None) if info is not None else None
+    if inner is not None:
+        inner(worker_id)
+    if os.getenv("DFTRACER_ENABLE") == "1":
+        try:
+            import atexit
+            logger = init_dftracer()
+            atexit.register(finalize_dftracer, logger)
+        except Exception:
+            pass
