+    def __read_bond_attrs__(self, h5_group):
+        attrs = h5_group.attrs
+        hbond = float(attrs[h5_hydrogen]) if h5_hydrogen in attrs.keys() else 0.0
+        hpbond = float(attrs[h5_hydrophobic]) if h5_hydrophobic in attrs.keys() else 0.0
+        habond = float(attrs[h5_halogen]) if h5_halogen in attrs.keys() else 0.0
+        sbond = float(attrs[h5_salt]) if h5_salt in attrs.keys() else 0.0
+        pbond = float(attrs[h5_pi]) if h5_pi in attrs.keys() else 0.0
+        return (hbond, hpbond, habond, sbond, pbond)

