{
  "enabledMcpjsonServers": [
    "dftracer"
  ],
  "env": {
    "REQUESTS_CA_BUNDLE": "/etc/pki/tls/cert.pem",
    "SSL_CERT_FILE": "/etc/pki/tls/cert.pem",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard_rm_drm.sh",
            "statusMessage": "Checking rm/drm target path..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/inject_context.py",
            "statusMessage": "Loading relevant project memory...",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(sudo)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(find /)",
      "Bash(find /etc*)",
      "Bash(find /var*)",
      "Bash(find /home*)",
      "Bash(find /root*)",
      "Bash(find /tmp*)",
      "Bash(find /opt*)",
      "Write(/etc/*)",
      "Write(/usr/*)",
      "Write(/var/*)",
      "Write(/tmp/*)",
      "Write(/home/*)",
      "Write(/root/*)"
    ],
    "allow": [
      "Edit(workspaces/*)",
      "Write(workspaces/*)",
      "Edit(src/dftracer_agents/.agents/skills/*)",
      "Write(src/dftracer_agents/.agents/skills/*)",
      "Bash(git add src/dftracer_agents/.agents/skills/*)",
      "Bash(git commit *)",
      "Bash(ls workspaces/*)",
      "Bash(mkdir -p workspaces/*)",
      "Bash(cp * workspaces/*)",
      "Bash(mv * workspaces/*)",
      "Bash(find workspaces/*)",
      "Bash(cat workspaces/*)",
      "Bash(rm -rf workspaces/*)",
      "Bash(rm -rf $PROJECT_ROOT/workspaces/*)",
      "Bash(mv workspaces/* workspaces/*)",
      "mcp__dftracer__agent_trace_compact",
